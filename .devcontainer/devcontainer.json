{
  "name": "Data Science for Biology — Workshop 2026",
  // Built from Dockerfile by .github/workflows/publish-image.yml. To change
  // the R packages, edit Dockerfile or install-r-packages.R and let that
  // workflow republish; codespaces made after that pull the new image.
  "image": "ghcr.io/elsherbini/data-science-for-biology-nov2026-codespace:nov2026",
  "features": {
    // Quarto CLI for rendering .qmd notebooks
    "ghcr.io/rocker-org/devcontainer-features/quarto-cli:1": {},
    // Node.js — required by the Claude Code CLI and the Pi coding agent
    "ghcr.io/devcontainers/features/node:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "REditorSupport.r",
        "quarto.quarto",
        "anthropic.claude-code"
      ],
      // Make saving work one click: typing a message and clicking Commit
      // stages everything and pushes to GitHub, with no separate Sync step.
      "settings": {
        "git.enableSmartCommit": true,
        "git.postCommitCommand": "push",
        "git.confirmSync": false
      }
    }
  },
  // The participant's OpenRouter API key arrives as the Codespaces secret
  // OPENROUTER_API_KEY. Claude Code reads it as ANTHROPIC_AUTH_TOKEN;
  // Pi reads OPENROUTER_API_KEY directly from the environment.
  "remoteEnv": {
    "ANTHROPIC_AUTH_TOKEN": "${containerEnv:OPENROUTER_API_KEY}",
    "OPENROUTER_API_KEY": "${containerEnv:OPENROUTER_API_KEY}"
  },
  "postCreateCommand": "bash .devcontainer/setup.sh"
}
